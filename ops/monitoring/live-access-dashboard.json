{
  "uid": "live-access-9000-9999",
  "title": "9000 / 9999 访问监控",
  "tags": ["access", "live-idol"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "每分钟请求数（按端口）",
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "live-access-loki" },
      "targets": [{ "refId": "A", "expr": "sum by (port) (count_over_time({job=~\"live-9999|oshi-9000\"} | json | kind=\"access\" [1m]))", "queryType": "range" }],
      "fieldConfig": { "defaults": { "unit": "reqpm" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "所选时间内请求总数",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "loki", "uid": "live-access-loki" },
      "targets": [{ "refId": "A", "expr": "sum(count_over_time({job=~\"live-9999|oshi-9000\"} | json | kind=\"access\" [$__range]))", "queryType": "instant" }],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "所选时间内 4xx / 5xx",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 4 },
      "datasource": { "type": "loki", "uid": "live-access-loki" },
      "targets": [{ "refId": "A", "expr": "sum(count_over_time({job=~\"live-9999|oshi-9000\"} | json | kind=\"access\" | status >= 400 [$__range]))", "queryType": "instant" }],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto" }
    },
    {
      "id": 4,
      "type": "bargauge",
      "title": "访问最多的 IP",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "loki", "uid": "live-access-loki" },
      "targets": [{ "refId": "A", "expr": "topk(10, sum by (ip) (count_over_time({job=~\"live-9999|oshi-9000\"} | json | kind=\"access\" [$__range])))", "queryType": "instant" }],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "访问最多的路径",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "loki", "uid": "live-access-loki" },
      "targets": [{ "refId": "A", "expr": "topk(10, sum by (path) (count_over_time({job=~\"live-9999|oshi-9000\"} | json | kind=\"access\" [$__range])))", "queryType": "instant" }],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "id": 6,
      "type": "logs",
      "title": "最新访问记录",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 18 },
      "datasource": { "type": "loki", "uid": "live-access-loki" },
      "targets": [{ "refId": "A", "expr": "{job=~\"live-9999|oshi-9000\"} | json | kind=\"access\"", "queryType": "range", "maxLines": 500 }],
      "options": { "showTime": true, "showLabels": false, "wrapLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending" }
    }
  ]
}
